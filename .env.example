# ==========================================
# ROBOQUEST LIVE COMPETITION PLATFORM CONFIG
# ==========================================

# Port to listen on (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Connection (SQLite default, or PostgreSQL/MySQL via Prisma)
DATABASE_URL="file:./dev.db"

# Secret key for JWT signing & admin session verification (Replace with a 64+ char random string in production)
JWT_SECRET="replace_with_a_secure_random_production_jwt_secret_key_roboquest_2026"

# Default Superadmin Credentials (created during prisma:seed)
ADMIN_DEFAULT_EMAIL="rajendrakumarmahanta22@gmail.com"
ADMIN_DEFAULT_PASSWORD="admin123"
